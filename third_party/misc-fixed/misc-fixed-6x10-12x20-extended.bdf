SIZE 20 75 75
FONTBOUNDINGBOX 12 20 0 0
STARTPROPERTIES 5
FAMILY_NAME "Misc Fixed 6x10 Extended"
COPYRIGHT "Public domain terminal emulator font.  Share and enjoy."
CHARSET_REGISTRY "ISO10646"
CHARSET_ENCODING "1"
SPACING "C"
ENDPROPERTIES
